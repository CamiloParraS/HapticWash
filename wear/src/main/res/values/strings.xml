    <!-- §1.3 user-facing Step names, in canonical order (labels 1..5). -->
    <string-array name="steps">
        <item>Palms</item>
        <item>Back of hands</item>
        <item>Between fingers</item>
        <item>Thumbs</item>
        <item>Fingertips</item>
    </string-array>

    <!-- Step guide why lines, canonical order: why the Step matters, in terms of what hands do. No named illnesses, no prevention claims (LanguageTest). -->
    <string-array name="step_whys">
        <item>Palms handle the most, so they pick up the most</item>
        <item>Backs of hands touch things too; palms never reach them</item>
        <item>What you touch gets trapped between fingers and skipped</item>
        <item>Thumbs grip everything, so they pick up whatever you touch</item>
        <item>Fingertips touch first, and only get soap if aimed there</item>
    </string-array>

    <!-- Step guide technique lines: what to do, shown above the study line. -->
    <string-array name="step_how">
        <item>Rub palm against palm</item>
        <item>Rub each back of hand with the other palm</item>
        <item>Interlace fingers and rub up and down</item>
        <item>Clasp each thumb and rub in a circle</item>
        <item>Rub fingertips in the opposite palm</item>
    </string-array>

